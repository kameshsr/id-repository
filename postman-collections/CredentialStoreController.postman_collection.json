{
  "info": {
    "name": "Credential Store (credential-service)",
    "description": "Postman collection for CredentialStoreController (MOSIP id-repository, credential-service).\n\nBase path: /v1/credentialservice (port 8095).\n\nSet `baseUrl` and `authToken` variables. Protected endpoints require `Authorization` cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8095/v1/credentialservice"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "currentUtcTimestamp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Credential (Issue)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"<UIN or VID>\",\n  \"credentialType\": \"euin\",\n  \"requestId\": \"<request-id>\",\n  \"issuer\": \"mpartner-default-print\",\n  \"recepiant\": \"\",\n  \"user\": \"mosip_user\",\n  \"encrypt\": false,\n  \"encryptionKey\": \"\",\n  \"sharableAttributes\": [\"fullName\", \"dateOfBirth\"],\n  \"additionalData\": {}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/issue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "issue"
          ]
        },
        "description": "POST /issue \u2014 creates the credential. Body is a plain CredentialServiceRequestDto (NOT wrapped in RequestWrapper). Role: postissue."
      }
    },
    {
      "name": "Get Credential Types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/types",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "types"
          ]
        },
        "description": "GET /types \u2014 lists supported credential types. No role check (PreAuthorize commented out)."
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('currentUtcTimestamp', new Date().toISOString());"
        ]
      }
    }
  ]
}