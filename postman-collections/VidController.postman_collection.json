{
  "info": {
    "name": "VID (vid-service)",
    "description": "Postman collection for VidController (MOSIP id-repository, id-repository-vid-service).\n\nBase path: /idrepository/v1 (port 8091).\n\nSet `baseUrl` and `authToken` variables. All endpoints require `Authorization` cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091/idrepository/v1",
      "description": "Service base URL. For deployed envs: https://<env-domain> + same path."
    },
    {
      "key": "authToken",
      "value": "",
      "description": "JWT from authmanager (clientidsecretkey: clientId=mosip-idrepo-client, appId=idrepo). Sent as Authorization cookie."
    },
    {
      "key": "uin",
      "value": "9758610623",
      "description": "Sample UIN (10-digit). Replace with a UIN existing in your environment."
    },
    {
      "key": "vid",
      "value": "6048372815873185",
      "description": "Sample 16-digit VID. Replace with a VID existing in your environment."
    },
    {
      "key": "currentUtcTimestamp",
      "value": "",
      "description": "Auto-filled by collection pre-request script. Do not set manually."
    }
  ],
  "item": [
    {
      "name": "Create VID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.vid.create\",\n  \"version\": \"v1\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"UIN\": \"{{uin}}\",\n    \"vidType\": \"PERPETUAL\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/vid",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid"
          ]
        },
        "description": "POST /vid \u2014 generates a new VID. vidType: PERPETUAL | TEMPORARY (per vid policy). Role: postvid."
      }
    },
    {
      "name": "Create Draft VID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.vid.create\",\n  \"version\": \"v1\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"UIN\": \"{{uin}}\",\n    \"vidType\": \"PERPETUAL\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/draft/vid",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "draft",
            "vid"
          ]
        },
        "description": "POST /draft/vid \u2014 generates a VID in DRAFT status. Role: postdraftvid."
      }
    },
    {
      "name": "Retrieve UIN by VID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vid/{{vid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "{{vid}}"
          ]
        },
        "description": "GET /vid/{VID} \u2014 returns the decrypted UIN for a valid VID. Role: getvid."
      }
    },
    {
      "name": "Retrieve VIDs by UIN",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vid/uin/{{uin}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "uin",
            "{{uin}}"
          ]
        },
        "description": "GET /vid/uin/{UIN} \u2014 lists all VIDs associated with a UIN. Role: getviduin."
      }
    },
    {
      "name": "Update VID Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.vid.update\",\n  \"version\": \"v1\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"vidStatus\": \"REVOKED\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/vid/{{vid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "{{vid}}"
          ]
        },
        "description": "PATCH /vid/{VID} \u2014 updates VID status (only if current status is ACTIVE). e.g. vidStatus: REVOKED, DEACTIVATED. Role: patchvid."
      }
    },
    {
      "name": "Regenerate VID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vid/{{vid}}/regenerate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "{{vid}}",
            "regenerate"
          ]
        },
        "description": "POST /vid/{VID}/regenerate \u2014 regenerates VID (current status must be ACTIVE, USED, or EXPIRED). Role: postvidregenerate."
      }
    },
    {
      "name": "Deactivate VIDs for UIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.vid.deactivate\",\n  \"version\": \"v1\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"UIN\": \"{{uin}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/vid/deactivate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "deactivate"
          ]
        },
        "description": "POST /vid/deactivate \u2014 deactivates all ACTIVE VIDs of the UIN. Role: postviddeactivate."
      }
    },
    {
      "name": "Reactivate VIDs for UIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.vid.reactivate\",\n  \"version\": \"v1\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"UIN\": \"{{uin}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/vid/reactivate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vid",
            "reactivate"
          ]
        },
        "description": "POST /vid/reactivate \u2014 reactivates DEACTIVATED/INACTIVE (non-expired) VIDs of the UIN. Role: postvidreactivate."
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('currentUtcTimestamp', new Date().toISOString());"
        ]
      }
    }
  ]
}