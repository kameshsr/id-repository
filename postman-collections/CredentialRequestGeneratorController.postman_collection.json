{
  "info": {
    "name": "Credential Request Generator",
    "description": "Postman collection for CredentialRequestGeneratorController (MOSIP id-repository).\n\nBase path: /v1/credentialrequest (port 8094).\n\nSet collection variables `baseUrl` and `authToken` before use. Protected endpoints require an `Authorization` cookie (MOSIP auth token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8094/v1/credentialrequest",
      "description": "Service base URL. For deployed envs: https://<env-domain> + same path."
    },
    {
      "key": "authToken",
      "value": "",
      "description": "JWT from authmanager (clientidsecretkey: clientId=mosip-idrepo-client, appId=idrepo). Sent as Authorization cookie."
    },
    {
      "key": "uin",
      "value": "9758610623",
      "description": "Sample UIN (10-digit). Replace with a UIN existing in your environment."
    },
    {
      "key": "requestId",
      "value": "0bf035cdb55bdd31a5905f8eba0c542d",
      "description": "Credential request id returned by POST /requestgenerator."
    },
    {
      "key": "rid",
      "value": "27847321742954220250616011728",
      "description": "Sample 29-digit registration id (RID)."
    },
    {
      "key": "currentUtcTimestamp",
      "value": "",
      "description": "Auto-filled by collection pre-request script. Do not set manually."
    }
  ],
  "item": [
    {
      "name": "Create Credential Issuance Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.credential.request.service.id\",\n  \"version\": \"1.0\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"id\": \"{{uin}}\",\n    \"credentialType\": \"euin\",\n    \"issuer\": \"mpartner-default-print\",\n    \"recepiant\": \"\",\n    \"user\": \"mosip_user\",\n    \"encrypt\": false,\n    \"encryptionKey\": \"\",\n    \"sharableAttributes\": [\"fullName\", \"dateOfBirth\"],\n    \"additionalData\": {}\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/requestgenerator",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requestgenerator"
          ]
        },
        "description": "POST /requestgenerator \u2014 creates a credential issuance request. Role: postrequestgenerator."
      }
    },
    {
      "name": "Create Credential Issuance Request by RID (v2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"mosip.credential.request.service.id\",\n  \"version\": \"1.0\",\n  \"requesttime\": \"{{currentUtcTimestamp}}\",\n  \"request\": {\n    \"id\": \"{{uin}}\",\n    \"credentialType\": \"euin\",\n    \"issuer\": \"mpartner-default-print\",\n    \"recepiant\": \"\",\n    \"user\": \"mosip_user\",\n    \"encrypt\": false,\n    \"encryptionKey\": \"\",\n    \"sharableAttributes\": [\"fullName\", \"dateOfBirth\"],\n    \"additionalData\": {}\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/requestgenerator/{{rid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v2",
            "requestgenerator",
            "{{rid}}"
          ]
        },
        "description": "POST /v2/requestgenerator/{rid} \u2014 creates a credential issuance request by RID. Role: postv2requestgeneratorrid."
      }
    },
    {
      "name": "Cancel Credential Request",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cancel/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cancel",
            "{{requestId}}"
          ]
        },
        "description": "GET /cancel/{requestId} \u2014 cancels a credential issuance request. Role: getcancelrequestid."
      }
    },
    {
      "name": "Get Credential Request Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/get/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "get",
            "{{requestId}}"
          ]
        },
        "description": "GET /get/{requestId} \u2014 gets credential issuance request status. Role: getgetrequestid."
      }
    },
    {
      "name": "Get Request Ids",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/getRequestIds?statusCode=FAILED&effectivedtimes=&pageNumber=0&pageSize=10&orderBy=updateDateTime&direction=DESC",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "getRequestIds"
          ],
          "query": [
            {
              "key": "statusCode",
              "value": "FAILED"
            },
            {
              "key": "effectivedtimes",
              "value": ""
            },
            {
              "key": "pageNumber",
              "value": "0"
            },
            {
              "key": "pageSize",
              "value": "10"
            },
            {
              "key": "orderBy",
              "value": "updateDateTime"
            },
            {
              "key": "direction",
              "value": "DESC"
            }
          ]
        },
        "description": "GET /getRequestIds \u2014 paginated list of request ids by status. Role: getgetrequestids."
      }
    },
    {
      "name": "Retrigger Credential Request",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "Authorization={{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/retrigger/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "retrigger",
            "{{requestId}}"
          ]
        },
        "description": "PUT /retrigger/{requestId} \u2014 retriggers (reprocesses) a credential request. Role: putretriggerrequestid."
      }
    },
    {
      "name": "WebSub Callback - Notify Status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"publisher\": \"CREDENTIAL_SERVICE\",\n  \"topic\": \"CREDENTIAL_STATUS_UPDATE\",\n  \"publishedOn\": \"{{currentUtcTimestamp}}\",\n  \"event\": {\n    \"id\": \"e2647e90-50d8-4f8d-9007-9dc9bf151fb1\",\n    \"requestId\": \"{{requestId}}\",\n    \"timestamp\": \"{{currentUtcTimestamp}}\",\n    \"status\": \"ISSUED\",\n    \"url\": \"\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/callback/notifyStatus",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "callback",
            "notifyStatus"
          ]
        },
        "description": "POST /callback/notifyStatus \u2014 WebSub callback for CREDENTIAL_STATUS_UPDATE topic. Normally invoked by the WebSub hub (intent verified, hub signature required); manual calls may be rejected."
      }
    },
    {
      "name": "Schedule Retry Subscription",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/scheduleRetrySubscription",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "scheduleRetrySubscription"
          ]
        },
        "description": "GET /scheduleRetrySubscription \u2014 schedules retry of WebSub subscriptions."
      }
    },
    {
      "name": "Schedule Websub Subscription",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/scheduleWebsubSubscription",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "scheduleWebsubSubscription"
          ]
        },
        "description": "GET /scheduleWebsubSubscription \u2014 schedules WebSub subscription."
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('currentUtcTimestamp', new Date().toISOString());"
        ]
      }
    }
  ]
}